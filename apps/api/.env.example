# Intelis API environment configuration (example — no secrets)
INTELIS_ENV=production
# Accepts either comma-separated origins or a JSON array
INTELIS_CORS_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:3000
# Optional overrides for hosted deployments (defaults resolve relative to repo root)
INTELIS_DATA_PROCESSED_DIR=../../data/processed
INTELIS_DATA_MANIFESTS_DIR=../../data/manifests
