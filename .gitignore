# OS & Editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment variables (never commit real secrets)
.env
.env*.local
*.env
!*.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / Next.js
node_modules/
.next/
apps/web/.next/
apps/web/out/
apps/web/coverage/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Raw source data (large 199MB GeoJSON download — keep excluded)
data/raw/*
!data/raw/.gitkeep

# Ephemeral databases
*.duckdb
*.duckdb.wal
