# OS & Editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment variables (never commit real secrets)
.env
.env*.local
*.env
!*.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / Next.js
node_modules/
.next/
apps/web/.next/
apps/web/out/
apps/web/coverage/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Data artefacts (raw downloads & generated binary parquet/geoparquet files)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.parquet
*.geoparquet
*.duckdb
*.duckdb.wal
